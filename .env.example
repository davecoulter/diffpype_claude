POSTGRES_USER=diffpype
POSTGRES_PASSWORD=diffpype
POSTGRES_DB=diffpype
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000

UI_PORT=5173
VITE_API_URL=http://localhost:8000

FLOWER_PORT=5555
PORTAINER_PORT=9000

TEST_DATABASE_URL=postgresql+psycopg2://diffpype:diffpype@db:5432/diffpype_test

# Application logging level (consumed by pydantic-settings -> src/core/config.py)
LOG_LEVEL=INFO

# Celery worker resource tuning
CELERY_LIGHT_CONCURRENCY=4
CELERY_LIGHT_MAX_MEMORY_PER_CHILD=200000
WORKER_LIGHT_MEM_LIMIT=512m

CELERY_HEAVY_CONCURRENCY=1
CELERY_HEAVY_MAX_MEMORY_PER_CHILD=8000000
WORKER_HEAVY_MEM_LIMIT=8g

# Admin & security (see doc 20 — set real values in .env and GitHub Actions secrets)
ADMIN_USER=sysadmin
ADMIN_PASSWORD=changeme
ADMIN_SECRET_KEY=diffpype-dev-secret-key-change-in-production
FLOWER_BASIC_AUTH=admin:changeme
CORS_ORIGINS=http://localhost:5173,http://0.0.0.0:5173

# Celery task reliability (see doc 21)
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=60
ENABLE_DB_BACKUP_CRON=false

# Database connection pool (see doc 22)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Observability & distributed tracing (see doc 23)
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Production/staging deployment image tag (see doc 24)
IMAGE_TAG=main

# S3-compatible object storage (see doc 27 — local MinIO mock). In a real cloud
# deployment: leave S3_ENDPOINT_URL blank to use AWS's real regional endpoints,
# and leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY blank to let boto3's default
# credential chain resolve an IAM role instead of these MinIO dev-only static keys.
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=diffpype-data
S3_REGION=us-east-1
# Host port mappings for the local MinIO container (container S3 API stays on 9000;
# host 9000 is taken by portainer, so the MinIO host API port is 9002)
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

# Storage backend selection (see doc 28) — "s3" (default, MinIO/S3-compatible) or
# "local" (filesystem-backed, e.g. for a real fiducial FITS set outside MinIO).
# LOCAL_STORAGE_ROOT is the path the app reads/writes *inside* the container
# (fixed at /data via the docker-compose bind mount below) or, for a bare-metal
# run with no Docker at all, a plain relative path on the host.
# LOCAL_STORAGE_HOST_PATH is the *host* directory bind-mounted to /data in
# api/worker_light/worker_heavy — override in .env to point at a real dataset;
# defaults to a git-ignored directory in the repo so a fresh clone works with
# no setup. Put raw FITS files at <LOCAL_STORAGE_HOST_PATH>/raw/ (flat, no
# subdirs — matches the raw/{base_filename} key layout).
STORAGE_BACKEND=s3
LOCAL_STORAGE_ROOT=./data
LOCAL_STORAGE_HOST_PATH=./local_storage_data
